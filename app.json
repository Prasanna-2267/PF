{
  "expo": {
    "name": "Parallax Flow",
    "slug": "parallax-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-eye.png",
    "scheme": "parallaxflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.parallaxflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE7",
        "foregroundImage": "./assets/images/android-icon-eye-foreground.png",
        "monochromeImage": "./assets/images/android-icon-eye-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5E6E5",
          "image": "./assets/images/splash-eye.png",
          "imageWidth": 210,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Parallax Flow to scan your Academy admission QR code.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB547",
          "defaultChannel": "learning-reminders"
        }
      ],
      "@config-plugins/react-native-pdf",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
