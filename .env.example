# ─────────────────────────────────────────────────────────────────────────────
# Production env for the Docker stack (docker-compose.prod.yml).
#   cp .env.example .env   then fill this in.  Never commit .env (it's gitignored).
#
# CLIENT_ORIGIN / NODE_ENV / PORT are set for you by docker-compose.prod.yml —
# don't add them here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your domain (no https://, no trailing slash) ──
# Caddy gets an HTTPS cert for this, and CLIENT_ORIGIN is derived from it.
DOMAIN=app.example.com

# ── Database — REQUIRED. Your MongoDB Atlas connection string. ──
MONGODB_URI=

# ── Auth secrets — REQUIRED in production. Generate each with: ──
#   docker run --rm node:22-slim node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Google SSO (optional) — both hold the SAME client ID. ──
# VITE_GOOGLE_CLIENT_ID is baked into the client at build time; GOOGLE_CLIENT_ID
# is used by the API at runtime.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── PDF storage: Cloudflare R2 (strongly recommended) ──
# Without it, uploads go to the container's disk (the `storage` volume). That
# survives redeploys here (unlike Render), but R2 is still recommended for real
# content. R2_ENDPOINT can be left blank if R2_ACCOUNT_ID is set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Email OTP + receipts: Resend ── (blank → OTPs printed to the logs)
MAIL_API_KEY=
MAIL_FROM=

# ── Payments: Razorpay ── (blank → checkout returns 503)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI grading: OpenAI ── (blank → keyword heuristic fallback)
OPENAI_API_KEY=
