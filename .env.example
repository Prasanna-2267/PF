# In development the app replaces a private/localhost hostname with Expo's
# active Metro host. This works on web, emulators and LAN-connected phones
# without editing this file whenever Wi-Fi changes.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Website origin used by locked package "Browse course" links.
EXPO_PUBLIC_STORE_BASE_URL=http://localhost:5173
EXPO_PUBLIC_NEURALWEB_LABS_URL=https://example.com

# Required for push-token registration in project-owned development and
# production builds. This is the Expo/EAS project UUID, not a secret.
EXPO_PUBLIC_EAS_PROJECT_ID=
