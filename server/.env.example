# ── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/parallax_flow
# Cloud (recommended, no install): paste your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/parallax_flow

# Optional: only needed if your network's DNS can't resolve mongodb+srv:// SRV
# records (symptom: "querySrv ECONNREFUSED"). Forces reliable public resolvers.
DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth (Phase 1) ─────────────────────────────────────
# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; in dev a temporary insecure value is used if unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Google sign-in: only the Client ID is needed (ID-token verification).
# It must match the client's VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google SSO.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (OTP verification, password reset, receipts) ──
# Leave everything blank in dev to print emails/OTPs to the server log.
#
# Option A — Gmail (what you have): set MAIL_PROVIDER=gmail and use a Google
#   "App Password" (needs 2-Step Verification on the account). Host/port are
#   auto-set to smtp.gmail.com:465.
MAIL_PROVIDER=gmail
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM="Parallax Flow <youraddress@gmail.com>"
#
# Option A2 — any other SMTP host: MAIL_PROVIDER=smtp + SMTP_HOST/SMTP_PORT below.
# SMTP_HOST=
# SMTP_PORT=587
#
# Option B — Resend (transactional API, best deliverability at scale):
#   MAIL_PROVIDER=resend, MAIL_API_KEY=re_xxx, MAIL_FROM="Parallax Flow <noreply@yourdomain>"
MAIL_API_KEY=

# ── Storage: Cloudflare R2 ─────────────────────────────
# Leave blank to use local-disk storage (./storage). To use R2, create an R2
# bucket + an API token (Object Read & Write), then set these. R2_ENDPOINT can
# be left blank if R2_ACCOUNT_ID is set (endpoint is derived from it).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Payments: Razorpay (Phase 4) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI grading: OpenAI (Phase 6) ───────────────────────
OPENAI_API_KEY=

# ── First admin seed (Phase 2) — used only by: npm run seed:admin ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# ADMIN_ROLE=superadmin   # optional; defaults to "admin"
