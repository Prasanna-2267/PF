# ── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/parallax_flow
# Cloud (recommended, no install): paste your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/parallax_flow

# Optional: only needed if your network's DNS can't resolve mongodb+srv:// SRV
# records (symptom: "querySrv ECONNREFUSED"). Forces reliable public resolvers.
DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth (Phase 1) ─────────────────────────────────────
# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; in dev a temporary insecure value is used if unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / OTP (Phase 1) ──────────────────────────────
# Leave blank in dev to print OTPs to the server log instead of sending email.
# To send real email, set both (Resend): MAIL_API_KEY=re_xxx, MAIL_FROM="Parallax Flow <noreply@yourdomain>"
MAIL_API_KEY=
MAIL_FROM=

# ── Storage: Cloudflare R2 (Phase 3) ───────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Payments: Razorpay (Phase 4) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI grading: OpenAI (Phase 6) ───────────────────────
OPENAI_API_KEY=
