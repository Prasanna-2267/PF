{
  "name": "parallax-flow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallax Flow API server",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "cross-env NODE_ENV=development tsx src/scripts/seed-admin.ts",
    "admins": "cross-env NODE_ENV=development tsx src/scripts/list-admins.ts",
    "test:smoke": "cross-env NODE_ENV=test tsx src/scripts/smoke-auth.ts",
    "test:smoke:content": "cross-env NODE_ENV=test tsx src/scripts/smoke-content.ts",
    "test:smoke:lessons": "cross-env NODE_ENV=test STORAGE_DIR=.test-storage tsx src/scripts/smoke-lessons.ts",
    "test:smoke:secure": "cross-env NODE_ENV=test STORAGE_DIR=.test-storage tsx src/scripts/smoke-secure.ts",
    "test:smoke:realtime": "cross-env NODE_ENV=test tsx src/scripts/smoke-realtime.ts",
    "test:smoke:commerce": "cross-env NODE_ENV=test STORAGE_DIR=.test-storage tsx src/scripts/smoke-commerce.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@napi-rs/canvas": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "mupdf": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^6.14.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
